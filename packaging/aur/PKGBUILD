# Maintainer: latedeployment
pkgname=oci2bin
pkgver=0.17.0
pkgrel=1
pkgdesc="Convert OCI/Docker images into self-contained ELF executables"
arch=('x86_64' 'aarch64')
url="https://github.com/latedeployment/oci2bin"
license=('MIT')
depends=('python' 'docker' 'gcc')
makedepends=('texinfo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9960cb690f4af3baee3172cb7393fd2d1906c69f2ca290c9f211bdc95e984ba9')

build() {
    cd "$pkgname-$pkgver"
    make loader
    make doc
}

package() {
    cd "$pkgname-$pkgver"
    make install PREFIX="$pkgdir/usr"
}
